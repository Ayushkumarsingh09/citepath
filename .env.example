# CitePath — environment template (no secrets)
DATABASE_URL=postgresql://citepath:citepath@localhost:55432/citepath
REDIS_URL=redis://localhost:6380
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: enable real AI drafts (otherwise demo templates labeled as demo)
AI_PROVIDER=openai
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini

# Reddit — use official API when available; public JSON fallback for lookups
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=CitePath/0.1 (local-dev)

# Object storage for knowledge uploads
S3_ENDPOINT=
S3_BUCKET=citepath
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email
EMAIL_PROVIDER_KEY=
EMAIL_FROM=noreply@citepath.local

# Demo mode seeds synthetic Reddit posts for local scans (clearly marked)
SENTRY_DSN=

# Worker (optional internal scan trigger)
WORKER_SCAN_TOKEN=
